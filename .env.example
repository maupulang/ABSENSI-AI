# Environment Configuration
SECRET_KEY=absensi_ai_super_secret_key_2026_change_in_production
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Firebase Configuration
FIREBASE_DATABASE_URL=https://absensi-ai-a8281-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=absensi-ai-a8281
FIREBASE_STORAGE_BUCKET=absensi-ai-a8281.firebasestorage.app
# Path to serviceAccountKey.json if using Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json
# Optional Firebase Database Secret if using REST API direct
FIREBASE_DB_SECRET=

# AI Face Recognition Settings
# Threshold for face recognition match (Cosine distance <= threshold, e.g. 0.40 - 0.50, or Euclidean <= 0.60)
FACE_MATCH_THRESHOLD=0.45
# Face model backend: 'opencv_dnn' or 'face_recognition'
FACE_DETECTION_MODEL=opencv_dnn

# Attendance Settings
ATTENDANCE_START_TIME=06:00
ATTENDANCE_LATE_TIME=07:15
ATTENDANCE_END_TIME=17:00
